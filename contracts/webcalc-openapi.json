{
  "components": {
    "schemas": {
      "CalculateRequest": {
        "properties": {
          "a": {
            "title": "A",
            "type": "number"
          },
          "b": {
            "title": "B",
            "type": "number"
          },
          "operator": {
            "description": "One of + - * / %. '%' returns a * (b / 100), i.e. b percent of a.",
            "title": "Operator",
            "type": "string"
          }
        },
        "required": [
          "a",
          "b",
          "operator"
        ],
        "title": "CalculateRequest",
        "type": "object"
      },
      "CalculateResponse": {
        "properties": {
          "expression": {
            "title": "Expression",
            "type": "string"
          },
          "result": {
            "title": "Result",
            "type": "number"
          }
        },
        "required": [
          "result",
          "expression"
        ],
        "title": "CalculateResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryItem": {
        "properties": {
          "angle_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Angle Mode"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expression": {
            "title": "Expression",
            "type": "string"
          },
          "function_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Function Type"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "result": {
            "title": "Result",
            "type": "number"
          }
        },
        "required": [
          "id",
          "expression",
          "result",
          "mode",
          "created_at"
        ],
        "title": "HistoryItem",
        "type": "object"
      },
      "ScientificRequest": {
        "properties": {
          "angle_mode": {
            "default": "deg",
            "title": "Angle Mode",
            "type": "string"
          },
          "exponent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exponent"
          },
          "function": {
            "title": "Function",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "function",
          "value"
        ],
        "title": "ScientificRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "WEB Calc API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/calculate": {
      "post": {
        "operationId": "calculate_api_calculate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Calculate"
      }
    },
    "/api/calculate/scientific": {
      "post": {
        "operationId": "calculate_scientific_api_calculate_scientific_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScientificRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Calculate Scientific"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/history": {
      "get": {
        "operationId": "history_api_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HistoryItem"
                  },
                  "title": "Response History Api History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "History"
      }
    }
  }
}
